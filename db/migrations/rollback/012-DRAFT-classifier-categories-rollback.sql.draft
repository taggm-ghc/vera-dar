-- 012_vera_classifier_categories ROLLBACK -- DRAFT, NOT EXECUTED. DESTRUCTIVE: drops the classifier category table and every row
-- (seed rows, runtime rows, every version). Owner-gated like the forward draft (db/migrations/pending/012-DRAFT-...).
-- Filename deliberately does not match apply_migrations.py's `{prefix}_vera_*.sql` glob; rename only at approval.
-- Needs the owner's separate, same-turn approval, the TABLE OWNER role (the triggers are owner-only by design), an isolated DB, and
-- an export of the table first. Never run via db/apply_migrations.py (its --dry-run executes on production; HZ-DAR-1).
-- Non-destructive rollback is: set classifier_category_table.read_from_db and registration_enabled to false in
-- config/scope_router.json (the service then reads the JSON seed), then REVOKE INSERT from vera_vjay_rw.
-- Dependency order: triggers (reference the functions and the table), then the table (drops its indexes and constraints), then
-- the functions (the guard uses is_owner). The schema vera_vjay is shared with other objects and is NOT dropped.
-- WARNING: this DELETES the seed rows AND every runtime row (all versions) with the table. Export first.
-- RUN WITH: psql -X -v ON_ERROR_STOP=1 -f <this file>   (own BEGIN/COMMIT; an error leaves everything in place).
-- Drops only the objects the forward file creates (IF EXISTS, no CASCADE); the schema is kept.
BEGIN;

DROP TRIGGER IF EXISTS clscat_no_truncate_trg ON vera_vjay.clscat_categories;
DROP TRIGGER IF EXISTS clscat_c_activate_trg ON vera_vjay.clscat_categories;
DROP TRIGGER IF EXISTS clscat_b_labels_trg ON vera_vjay.clscat_categories;
DROP TRIGGER IF EXISTS clscat_a_guard_trg ON vera_vjay.clscat_categories;

DROP INDEX IF EXISTS vera_vjay.clscat_rank_uq;
DROP INDEX IF EXISTS vera_vjay.clscat_one_active_uq;
DROP TABLE IF EXISTS vera_vjay.clscat_categories;

DROP FUNCTION IF EXISTS vera_vjay.clscat_forbid_truncate_trgfn();
DROP FUNCTION IF EXISTS vera_vjay.clscat_activate_trgfn();
DROP FUNCTION IF EXISTS vera_vjay.clscat_label_unique_trgfn();
DROP FUNCTION IF EXISTS vera_vjay.clscat_guard_trgfn();
DROP FUNCTION IF EXISTS vera_vjay.clscat_is_owner_fn();

COMMIT;
