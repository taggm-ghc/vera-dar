-- Seed count assertions (a RAISE rolls everything back).
DO $$
BEGIN
  IF (SELECT count(*) FROM vera_vjay.lstreg_lists) <> 10
     OR (SELECT count(*) FROM vera_vjay.lstreg_items) <> 190
     OR (SELECT count(*) FROM vera_vjay.licallow_licences) <> 35
     OR (SELECT count(*) FROM vera_vjay.entreg_entities) <> 13
     OR (SELECT count(*) FROM vera_vjay.rptout_outlets) <> 18 THEN
    RAISE EXCEPTION '016 seed count check failed (expected lists 10, items 190, licences 35, entities 13, outlets 18).';
  END IF;
  IF EXISTS (SELECT 1 FROM vera_vjay.lstreg_active_lists_v v
              WHERE NOT EXISTS (SELECT 1 FROM vera_vjay.lstreg_active_items_v i WHERE i.list_name = v.list_name)
                AND v.list_name NOT IN ('fetch.deny_hosts','permissions.deny_hosts')) THEN
    RAISE EXCEPTION '016 seed check failed: an active list (other than the two empty deny lists) has no active items.';
  END IF;
  IF (SELECT count(*) FROM vera_vjay.lstreg_active_lists_v) <> 10 THEN
    RAISE EXCEPTION '016 seed check failed: expected 10 active lists.';
  END IF;
END $$;

-- ---------------------------------------------------------------------------------------------------------------------
-- Privileges (review F4): revoke everything first (live default privileges may grant ro SELECT on tables, rw USAGE on sequences,
-- PUBLIC EXECUTE on functions), then grant SELECT on the two views to ro and rw only.
-- ---------------------------------------------------------------------------------------------------------------------
REVOKE ALL ON vera_vjay.lstreg_lists, vera_vjay.lstreg_items, vera_vjay.licallow_licences, vera_vjay.entreg_entities,
              vera_vjay.rptout_outlets, vera_vjay.lstreg_active_lists_v, vera_vjay.lstreg_active_items_v
  FROM PUBLIC, vera_vjay_ro, vera_vjay_rw, vera_vjay_wo;
DO $$
DECLARE t text;
BEGIN
  FOREACH t IN ARRAY ARRAY['lstreg_lists','lstreg_items','licallow_licences','entreg_entities','rptout_outlets'] LOOP
    EXECUTE pg_catalog.format('REVOKE ALL ON SEQUENCE %s FROM PUBLIC, vera_vjay_ro, vera_vjay_rw, vera_vjay_wo',
                              pg_catalog.pg_get_serial_sequence('vera_vjay.' || t, 'row_id'));
  END LOOP;
END $$;
REVOKE EXECUTE ON FUNCTION vera_vjay.lstreg_insert_trgfn(), vera_vjay.lstreg_update_trgfn(),
                           vera_vjay.lstreg_no_delete_trgfn(), vera_vjay.lstreg_no_truncate_trgfn()
  FROM PUBLIC, vera_vjay_ro, vera_vjay_rw, vera_vjay_wo;
DO $$   -- schema USAGE is NOT granted here: it must already exist (from 001); fail closed otherwise
BEGIN
  IF NOT (pg_catalog.has_schema_privilege('vera_vjay_ro', 'vera_vjay', 'USAGE')
          AND pg_catalog.has_schema_privilege('vera_vjay_rw', 'vera_vjay', 'USAGE')) THEN
    RAISE EXCEPTION '016 refused: vera_vjay_ro/vera_vjay_rw lack USAGE on schema vera_vjay (expected from migration 001); nothing applied.';
  END IF;
END $$;
GRANT SELECT ON vera_vjay.lstreg_active_lists_v, vera_vjay.lstreg_active_items_v TO vera_vjay_ro, vera_vjay_rw;

-- In-transaction ACL assertions (a RAISE rolls everything back; modelled on 015).
DO $$
DECLARE ro oid := (SELECT oid FROM pg_catalog.pg_roles WHERE rolname = 'vera_vjay_ro');
        rw oid := (SELECT oid FROM pg_catalog.pg_roles WHERE rolname = 'vera_vjay_rw');
        t text; p text; r text;
BEGIN
  -- base tables and identity sequences: no grantee other than the owner (grantee 0 = PUBLIC is also refused); no column grants.
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_class c CROSS JOIN LATERAL pg_catalog.aclexplode(c.relacl) a
              WHERE c.oid IN ('vera_vjay.lstreg_lists'::regclass, 'vera_vjay.lstreg_items'::regclass,
                              'vera_vjay.licallow_licences'::regclass, 'vera_vjay.entreg_entities'::regclass,
                              'vera_vjay.rptout_outlets'::regclass)
                AND a.grantee <> c.relowner)
     OR EXISTS (SELECT 1 FROM pg_catalog.pg_class c CROSS JOIN LATERAL pg_catalog.aclexplode(c.relacl) a
                 WHERE c.relnamespace = 'vera_vjay'::regnamespace AND c.relkind = 'S'
                   AND c.relname IN ('lstreg_lists_row_id_seq','lstreg_items_row_id_seq','licallow_licences_row_id_seq',
                                     'entreg_entities_row_id_seq','rptout_outlets_row_id_seq')
                   AND a.grantee <> c.relowner)
     OR EXISTS (SELECT 1 FROM pg_catalog.pg_attribute
                 WHERE attrelid IN ('vera_vjay.lstreg_lists'::regclass, 'vera_vjay.lstreg_items'::regclass,
                                    'vera_vjay.licallow_licences'::regclass, 'vera_vjay.entreg_entities'::regclass,
                                    'vera_vjay.rptout_outlets'::regclass,
                                    'vera_vjay.lstreg_active_lists_v'::regclass, 'vera_vjay.lstreg_active_items_v'::regclass)
                   AND attacl IS NOT NULL) THEN
    RAISE EXCEPTION '016 ACL check failed: a non-owner holds a privilege on a base table or identity sequence (or a column grant exists).';
  END IF;
  -- views: only SELECT, only for ro and rw.
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_class c CROSS JOIN LATERAL pg_catalog.aclexplode(c.relacl) a
              WHERE c.oid IN ('vera_vjay.lstreg_active_lists_v'::regclass, 'vera_vjay.lstreg_active_items_v'::regclass)
                AND a.grantee <> c.relowner
                AND NOT (a.privilege_type = 'SELECT' AND a.grantee IN (ro, rw))) THEN
    RAISE EXCEPTION '016 ACL check failed: a view grant other than SELECT for vera_vjay_ro / vera_vjay_rw.';
  END IF;
  IF (SELECT count(*) FROM pg_catalog.pg_class c CROSS JOIN LATERAL pg_catalog.aclexplode(c.relacl) a
       WHERE c.oid IN ('vera_vjay.lstreg_active_lists_v'::regclass, 'vera_vjay.lstreg_active_items_v'::regclass)
         AND a.grantee IN (ro, rw) AND a.privilege_type = 'SELECT') <> 4 THEN
    RAISE EXCEPTION '016 ACL check failed: expected SELECT on both views for both ro and rw.';
  END IF;
  -- functions: owner only (proacl NULL would mean PUBLIC EXECUTE).
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_proc p
              WHERE p.pronamespace = 'vera_vjay'::regnamespace
                AND p.proname IN ('lstreg_insert_trgfn','lstreg_update_trgfn','lstreg_no_delete_trgfn','lstreg_no_truncate_trgfn')
                AND (p.proacl IS NULL OR EXISTS (SELECT 1 FROM pg_catalog.aclexplode(p.proacl) a WHERE a.grantee <> p.proowner))) THEN
    RAISE EXCEPTION '016 ACL check failed: a lstreg_ trigger function is executable by a non-owner or PUBLIC.';
  END IF;
  -- view properties: security_barrier on, security_invoker off, owner = this session's role.
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_class c
              WHERE c.oid IN ('vera_vjay.lstreg_active_lists_v'::regclass, 'vera_vjay.lstreg_active_items_v'::regclass)
                AND (NOT COALESCE(c.reloptions @> ARRAY['security_barrier=true'], false)
                     OR COALESCE(c.reloptions::text ~ 'security_invoker=(true|on)', false)
                     OR pg_catalog.pg_get_userbyid(c.relowner) <> current_user)) THEN
    RAISE EXCEPTION '016 view check failed: views must be security_barrier, not security_invoker, and owned by the migration owner.';
  END IF;
  -- effective privileges (the group roles; logins inherit them): ro and rw read the views only, wo nothing, nobody writes.
  FOREACH r IN ARRAY ARRAY['vera_vjay_ro','vera_vjay_rw','vera_vjay_wo'] LOOP
    FOREACH t IN ARRAY ARRAY['vera_vjay.lstreg_lists','vera_vjay.lstreg_items','vera_vjay.licallow_licences',
                             'vera_vjay.entreg_entities','vera_vjay.rptout_outlets'] LOOP
      FOREACH p IN ARRAY ARRAY['SELECT','INSERT','UPDATE','DELETE','TRUNCATE','REFERENCES','TRIGGER'] LOOP
        IF pg_catalog.has_table_privilege(r, t, p) THEN
          RAISE EXCEPTION '016 grant check failed: % holds % on base table %.', r, p, t;
        END IF;
      END LOOP;
    END LOOP;
    FOREACH t IN ARRAY ARRAY['vera_vjay.lstreg_active_lists_v','vera_vjay.lstreg_active_items_v'] LOOP
      FOREACH p IN ARRAY ARRAY['INSERT','UPDATE','DELETE','TRUNCATE','REFERENCES','TRIGGER'] LOOP
        IF pg_catalog.has_table_privilege(r, t, p) THEN
          RAISE EXCEPTION '016 grant check failed: % holds % on view %.', r, p, t;
        END IF;
      END LOOP;
      IF pg_catalog.has_table_privilege(r, t, 'SELECT') <> (r IN ('vera_vjay_ro','vera_vjay_rw')) THEN
        RAISE EXCEPTION '016 grant check failed: wrong SELECT on view % for %.', t, r;
      END IF;
    END LOOP;
  END LOOP;
END $$;

COMMIT;
