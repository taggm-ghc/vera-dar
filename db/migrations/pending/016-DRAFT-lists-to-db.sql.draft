-- 016_vera_lists_to_db.sql -- DRAFT. NOT EXECUTED. Not a live migration: it sits under staged/ and is invisible to the runner.
-- LISTS-TO-DB-1104 (owner directive 2026-11-04: "data in lists and lists should be in a table in the db!"). Authored 2026-11-05 by
-- LTD-016-AUTHOR-1105 at the owner-approved staged path (denial LTD-1 closed). Design: work/LISTS-TO-DB-1104/design.md; review: review.md.
-- WHAT: five tables and two views in schema vera_vjay, then seeds 10 config lists (verbatim from the repo config files):
--   lstreg_lists        one row per list (version, state, payload {shape, combine, policy_class, file, path})
--   lstreg_items        string lists and the trace key allowlist (news.fallback_order, acquire.search_providers,
--                       scope.offtopic_providers, trace.key_allowlist, digest.numeric_words, fetch.deny_hosts, permissions.deny_hosts)
--   licallow_licences   licence.allowlist   (supersedes the separate LICENCE-ALLOWLIST-1104 016 draft)
--   entreg_entities     entity.registry     (supersedes draft 014 entity_registry)
--   rptout_outlets      news.outlets
--   lstreg_active_lists_v / lstreg_active_items_v   the ONLY objects an app role can read (security_barrier, owner-run).
-- NAMING EXCEPTION (review F10): four prefixes in one file because the owner scripts pin these table names
--   (scripts/lists_common.sh OBJECTS_SQL); trigger functions are shared under lstreg_.
-- ROLES / GRANTS: no role is created or altered. SELECT on the two views to the GROUP roles vera_vjay_ro and vera_vjay_rw ONLY.
--   NO privilege on any base table, identity sequence or function for PUBLIC or any app role (review F4); vera_vjay_wo gets nothing.
--   Only this file's own new objects are revoked below (the per-object grants that the 001 default privileges put on them);
--   the 001 default privileges themselves are not changed, and no existing object is touched.
--   All list changes are owner-run (the migration owner role): app roles cannot write.
-- SEMANTICS: rows are immutable after insert except `state`; a content change = a new version row. Version is max+1 (a key's
--   first row may carry any version >= 1, so the seed can keep payload.version). Activating a row retires the other active row
--   of the same key. DELETE and TRUNCATE are refused (retire instead). created_at/modified_at are set by trigger.
-- APPLYING NEEDS OWNER-APPROVED DDL in that turn (AGENTS.md section 7), admin/owner-run only, never via db/apply_migrations.py.
--   Use work/LISTS-TO-DB-1104/scripts/apply_016.sh (dry run by default). The app flag config/list_tables.json read_from_db stays false.
-- UNTESTED against a real PostgreSQL: CHECKs, triggers and views have never been executed (offline review only).
-- Rollback (destructive, separate approval): staged/db/migrations/rollback/016-DRAFT-lists-to-db-rollback.sql.draft
-- RUN WITH: psql -X -v ON_ERROR_STOP=1 -f <this file>   (own BEGIN/COMMIT; any error leaves nothing applied).
BEGIN;

-- Preflight 1: schema exists; nothing this file creates may exist (also the idempotence guard: a second run aborts here).
DO $$
DECLARE n text;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_namespace WHERE nspname = 'vera_vjay') THEN
    RAISE EXCEPTION '016 requires schema vera_vjay to exist (001 first); this file does not create it.';
  END IF;
  FOREACH n IN ARRAY ARRAY['lstreg_lists','lstreg_items','licallow_licences','entreg_entities','rptout_outlets',
                           'lstreg_active_lists_v','lstreg_active_items_v'] LOOP
    IF pg_catalog.to_regclass('vera_vjay.' || n) IS NOT NULL THEN
      RAISE EXCEPTION '016 already applied or name collision: vera_vjay.% exists.', n;
    END IF;
  END LOOP;
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace ns ON ns.oid = c.relnamespace
              WHERE ns.nspname = 'vera_vjay'
                AND (c.relname ~ '^(lstreg|licallow|entreg|rptout)_' )) THEN
    RAISE EXCEPTION '016 name collision: a relation (index, sequence, table) with a lstreg_/licallow_/entreg_/rptout_ prefix exists.';
  END IF;
  IF EXISTS (SELECT 1 FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace ns ON ns.oid = p.pronamespace
              WHERE ns.nspname = 'vera_vjay'
                AND p.proname IN ('lstreg_insert_trgfn','lstreg_update_trgfn','lstreg_no_delete_trgfn','lstreg_no_truncate_trgfn')) THEN
    RAISE EXCEPTION '016 name collision: a lstreg_ trigger function exists.';
  END IF;
END $$;

-- Preflight 2 (review F4/F5, as 012 R1(a)): the three group roles exist, and this session's role (the owner of everything
-- created here) is neither an app role nor a direct member of one. No role is created or altered.
DO $$
DECLARE g text;
BEGIN
  FOREACH g IN ARRAY ARRAY['vera_vjay_ro','vera_vjay_rw','vera_vjay_wo'] LOOP
    IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = g) THEN
      RAISE EXCEPTION '016 requires group role % (db/accounts/create_vera_accounts.sql first).', g;
    END IF;
  END LOOP;
  IF current_user IN ('vera_vjay_ro','vera_vjay_rw','vera_vjay_wo','vera_claude_code_rw','vera_pipeline_wo','vera_eval_ro')
     OR EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members m
                  JOIN pg_catalog.pg_roles r ON r.oid = m.roleid
                  JOIN pg_catalog.pg_roles mem ON mem.oid = m.member
                 WHERE mem.rolname = current_user AND r.rolname IN ('vera_vjay_ro','vera_vjay_rw','vera_vjay_wo')) THEN
    RAISE EXCEPTION '016 must be run as the owner role, not an application role or a direct member of one.';
  END IF;
END $$;

-- ---------------------------------------------------------------------------------------------------------------------
-- Tables. Core columns are identical in all five; the typed tables add per-list payload CHECKs.
-- ---------------------------------------------------------------------------------------------------------------------
CREATE TABLE vera_vjay.lstreg_lists (
    row_id       BIGINT GENERATED ALWAYS AS IDENTITY CONSTRAINT lstreg_lists_pk PRIMARY KEY,
    list_name    TEXT NOT NULL CONSTRAINT lstreg_lists_list_chk CHECK (list_name ~ '^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)+$'),
    item_key     TEXT NOT NULL CONSTRAINT lstreg_lists_key_chk CHECK (item_key <> '' AND length(item_key) <= 300),
    item_rank    INTEGER CONSTRAINT lstreg_lists_rank_chk CHECK (item_rank IS NULL OR item_rank >= 0),
    version      INTEGER NOT NULL CONSTRAINT lstreg_lists_ver_chk CHECK (version >= 1),
    state        TEXT NOT NULL CONSTRAINT lstreg_lists_state_chk CHECK (state IN ('draft','active','suspended','retired')),
    origin       TEXT NOT NULL CONSTRAINT lstreg_lists_origin_chk CHECK (origin IN ('seed','owner')),
    payload      JSONB NOT NULL CONSTRAINT lstreg_lists_payload_chk CHECK (jsonb_typeof(payload) = 'object' AND length(payload::text) <= 65536),
    created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
    modified_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT lstreg_lists_pver_chk CHECK (CASE WHEN payload ? 'version' THEN payload -> 'version' = pg_catalog.to_jsonb(version) ELSE true END),
    CONSTRAINT lstreg_lists_key_ver_uq UNIQUE (list_name, item_key, version),
    CONSTRAINT lstreg_lists_self_chk CHECK (item_key = list_name),
    CONSTRAINT lstreg_lists_def_chk CHECK ((
      payload ->> 'shape' IN ('strings','records','stage_keys')
      AND payload ->> 'combine' IN ('replace','union')
      AND payload ->> 'policy_class' IN ('safety','operational')
      AND jsonb_typeof(payload -> 'file') = 'string'
      AND jsonb_typeof(payload -> 'path') = 'array') IS TRUE)
);
COMMENT ON TABLE vera_vjay.lstreg_lists IS 'LISTS-TO-DB-1104: one row per config list (versioned). Owner-written; app roles read only the active view.';

CREATE TABLE vera_vjay.lstreg_items (
    row_id       BIGINT GENERATED ALWAYS AS IDENTITY CONSTRAINT lstreg_items_pk PRIMARY KEY,
    list_name    TEXT NOT NULL CONSTRAINT lstreg_items_list_chk CHECK (list_name ~ '^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)+$'),
    item_key     TEXT NOT NULL CONSTRAINT lstreg_items_key_chk CHECK (item_key <> '' AND length(item_key) <= 300),
    item_rank    INTEGER CONSTRAINT lstreg_items_rank_chk CHECK (item_rank IS NULL OR item_rank >= 0),
    version      INTEGER NOT NULL CONSTRAINT lstreg_items_ver_chk CHECK (version >= 1),
    state        TEXT NOT NULL CONSTRAINT lstreg_items_state_chk CHECK (state IN ('draft','active','suspended','retired')),
    origin       TEXT NOT NULL CONSTRAINT lstreg_items_origin_chk CHECK (origin IN ('seed','owner')),
    payload      JSONB NOT NULL CONSTRAINT lstreg_items_payload_chk CHECK (jsonb_typeof(payload) = 'object' AND length(payload::text) <= 65536),
    created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
    modified_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT lstreg_items_pver_chk CHECK (CASE WHEN payload ? 'version' THEN payload -> 'version' = pg_catalog.to_jsonb(version) ELSE true END),
    CONSTRAINT lstreg_items_key_ver_uq UNIQUE (list_name, item_key, version),
    CONSTRAINT lstreg_items_own_list_chk CHECK (list_name NOT IN ('licence.allowlist','entity.registry','news.outlets')),
    CONSTRAINT lstreg_items_host_chk CHECK (list_name NOT IN ('fetch.deny_hosts','permissions.deny_hosts')
                                            OR item_key ~ '^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$'),
    CONSTRAINT lstreg_items_trace_chk CHECK ((list_name <> 'trace.key_allowlist'
      OR (item_key ~ '^[a-z][a-z0-9_]*(:[A-Za-z0-9_]+([.][A-Za-z0-9_]+)?)?$'
          AND jsonb_typeof(payload -> 'stage') = 'string'
          AND pg_catalog.split_part(item_key, ':', 1) = payload ->> 'stage')) IS TRUE)
);
COMMENT ON TABLE vera_vjay.lstreg_items IS 'LISTS-TO-DB-1104: items of the string lists and the trace key allowlist (item_key = the string, or <stage>, <stage>:<key>, <stage>:<parent>.<key>).';

CREATE TABLE vera_vjay.licallow_licences (
    row_id       BIGINT GENERATED ALWAYS AS IDENTITY CONSTRAINT licallow_licences_pk PRIMARY KEY,
    list_name    TEXT NOT NULL CONSTRAINT licallow_licences_list_chk CHECK (list_name ~ '^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)+$'),
    item_key     TEXT NOT NULL CONSTRAINT licallow_licences_key_chk CHECK (item_key <> '' AND length(item_key) <= 300),
    item_rank    INTEGER CONSTRAINT licallow_licences_rank_chk CHECK (item_rank IS NULL OR item_rank >= 0),
    version      INTEGER NOT NULL CONSTRAINT licallow_licences_ver_chk CHECK (version >= 1),
    state        TEXT NOT NULL CONSTRAINT licallow_licences_state_chk CHECK (state IN ('draft','active','suspended','retired')),
    origin       TEXT NOT NULL CONSTRAINT licallow_licences_origin_chk CHECK (origin IN ('seed','owner')),
    payload      JSONB NOT NULL CONSTRAINT licallow_licences_payload_chk CHECK (jsonb_typeof(payload) = 'object' AND length(payload::text) <= 65536),
    created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
    modified_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT licallow_licences_pver_chk CHECK (CASE WHEN payload ? 'version' THEN payload -> 'version' = pg_catalog.to_jsonb(version) ELSE true END),
    CONSTRAINT licallow_licences_key_ver_uq UNIQUE (list_name, item_key, version),
    CONSTRAINT licallow_licences_own_list_chk CHECK (list_name = 'licence.allowlist'),
    CONSTRAINT licallow_licences_id_chk CHECK ((item_key = payload ->> 'id') IS TRUE),
    CONSTRAINT licallow_licences_flags_chk CHECK ((
      jsonb_typeof(payload -> 'storable') = 'boolean'
      AND COALESCE(jsonb_typeof(payload -> 'nd'),     'null') IN ('boolean','null')
      AND COALESCE(jsonb_typeof(payload -> 'nc'),     'null') IN ('boolean','null')
      AND COALESCE(jsonb_typeof(payload -> 'sa'),     'null') IN ('boolean','null')
      AND COALESCE(jsonb_typeof(payload -> 'reject'), 'null') IN ('boolean','null')
      AND COALESCE(jsonb_typeof(payload -> 'aliases'), 'array') = 'array'
      AND COALESCE(jsonb_typeof(payload -> 'urls'),    'array') = 'array') IS TRUE),
    CONSTRAINT licallow_licences_storable_chk CHECK (
      NOT (COALESCE(payload -> 'storable' = 'true'::jsonb, false)
           AND (COALESCE(payload -> 'nd' = 'true'::jsonb, false) OR COALESCE(payload -> 'reject' = 'true'::jsonb, false)))),
    CONSTRAINT licallow_licences_approved_chk CHECK ((
      state <> 'active' OR (jsonb_typeof(payload -> 'approved_by') = 'string' AND (payload ->> 'approved_by') <> '')) IS TRUE)
);
COMMENT ON TABLE vera_vjay.licallow_licences IS 'LISTS-TO-DB-1104: licence.allowlist. storable implies not nd and not reject; an active row needs approved_by.';

CREATE TABLE vera_vjay.entreg_entities (
    row_id       BIGINT GENERATED ALWAYS AS IDENTITY CONSTRAINT entreg_entities_pk PRIMARY KEY,
    list_name    TEXT NOT NULL CONSTRAINT entreg_entities_list_chk CHECK (list_name ~ '^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)+$'),
    item_key     TEXT NOT NULL CONSTRAINT entreg_entities_key_chk CHECK (item_key <> '' AND length(item_key) <= 300),
    item_rank    INTEGER CONSTRAINT entreg_entities_rank_chk CHECK (item_rank IS NULL OR item_rank >= 0),
    version      INTEGER NOT NULL CONSTRAINT entreg_entities_ver_chk CHECK (version >= 1),
    state        TEXT NOT NULL CONSTRAINT entreg_entities_state_chk CHECK (state IN ('draft','active','suspended','retired')),
    origin       TEXT NOT NULL CONSTRAINT entreg_entities_origin_chk CHECK (origin IN ('seed','owner')),
    payload      JSONB NOT NULL CONSTRAINT entreg_entities_payload_chk CHECK (jsonb_typeof(payload) = 'object' AND length(payload::text) <= 65536),
    created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
    modified_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT entreg_entities_pver_chk CHECK (CASE WHEN payload ? 'version' THEN payload -> 'version' = pg_catalog.to_jsonb(version) ELSE true END),
    CONSTRAINT entreg_entities_key_ver_uq UNIQUE (list_name, item_key, version),
    CONSTRAINT entreg_entities_own_list_chk CHECK (list_name = 'entity.registry'),
    CONSTRAINT entreg_entities_key_lc_chk CHECK ((item_key = lower(payload ->> 'entity')) IS TRUE),
    CONSTRAINT entreg_entities_verdicts_chk CHECK (
      COALESCE(payload ->> 'access_verdict',     'unknown') IN ('allow','forbid','unknown')
      AND COALESCE(payload ->> 'derivative_verdict', 'unknown') IN ('allow','forbid','unknown')
      AND COALESCE(payload ->> 'ingest_verdict',     'unknown') IN ('allow','forbid','unknown')
      AND COALESCE(payload ->> 'terms_verdict',      'unknown') IN ('allow','links_only','unknown')),
    CONSTRAINT entreg_entities_shape_chk CHECK ((
      jsonb_typeof(payload -> 'domains') = 'array'
      AND NOT jsonb_path_exists(payload, '$.domains[*] ? (@.type() != "string" || !(@ like_regex "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"))')
      AND COALESCE(jsonb_typeof(payload -> 'aliases'), 'array') = 'array'
      AND COALESCE(jsonb_typeof(payload -> 'allowed_paths'), 'object') = 'object') IS TRUE)
);
COMMENT ON TABLE vera_vjay.entreg_entities IS 'LISTS-TO-DB-1104: entity.registry (official-lane entities with access/derivative/ingest verdicts). Domains are exact hosts, no wildcards.';

CREATE TABLE vera_vjay.rptout_outlets (
    row_id       BIGINT GENERATED ALWAYS AS IDENTITY CONSTRAINT rptout_outlets_pk PRIMARY KEY,
    list_name    TEXT NOT NULL CONSTRAINT rptout_outlets_list_chk CHECK (list_name ~ '^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)+$'),
    item_key     TEXT NOT NULL CONSTRAINT rptout_outlets_key_chk CHECK (item_key <> '' AND length(item_key) <= 300),
    item_rank    INTEGER CONSTRAINT rptout_outlets_rank_chk CHECK (item_rank IS NULL OR item_rank >= 0),
    version      INTEGER NOT NULL CONSTRAINT rptout_outlets_ver_chk CHECK (version >= 1),
    state        TEXT NOT NULL CONSTRAINT rptout_outlets_state_chk CHECK (state IN ('draft','active','suspended','retired')),
    origin       TEXT NOT NULL CONSTRAINT rptout_outlets_origin_chk CHECK (origin IN ('seed','owner')),
    payload      JSONB NOT NULL CONSTRAINT rptout_outlets_payload_chk CHECK (jsonb_typeof(payload) = 'object' AND length(payload::text) <= 65536),
    created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
    modified_at  TIMESTAMPTZ NOT NULL DEFAULT now(),
    CONSTRAINT rptout_outlets_pver_chk CHECK (CASE WHEN payload ? 'version' THEN payload -> 'version' = pg_catalog.to_jsonb(version) ELSE true END),
    CONSTRAINT rptout_outlets_key_ver_uq UNIQUE (list_name, item_key, version),
    CONSTRAINT rptout_outlets_own_list_chk CHECK (list_name = 'news.outlets'),
    CONSTRAINT rptout_outlets_host_chk CHECK ((
      item_key = lower(payload ->> 'host') AND item_key ~ '^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$') IS TRUE),
    CONSTRAINT rptout_outlets_terms_chk CHECK ((payload ->> 'terms_verdict' IN ('allow','links_only','unknown')) IS TRUE),
    CONSTRAINT rptout_outlets_delay_chk CHECK (COALESCE(jsonb_typeof(payload -> 'crawl_delay_s'), 'null') IN ('number','null'))
);
COMMENT ON TABLE vera_vjay.rptout_outlets IS 'LISTS-TO-DB-1104: news.outlets (reporting lane) with terms verdict and crawl delay.';

-- One active row per (list, key) in each table.
CREATE UNIQUE INDEX lstreg_lists_one_active_uq ON vera_vjay.lstreg_lists (list_name) WHERE state = 'active';
CREATE UNIQUE INDEX lstreg_items_one_active_uq ON vera_vjay.lstreg_items (list_name, item_key) WHERE state = 'active';
CREATE UNIQUE INDEX licallow_licences_one_active_uq ON vera_vjay.licallow_licences (list_name, item_key) WHERE state = 'active';
CREATE UNIQUE INDEX entreg_entities_one_active_uq ON vera_vjay.entreg_entities (list_name, item_key) WHERE state = 'active';
CREATE UNIQUE INDEX rptout_outlets_one_active_uq ON vera_vjay.rptout_outlets (list_name, item_key) WHERE state = 'active';

-- ---------------------------------------------------------------------------------------------------------------------
-- Shared trigger functions (dynamic table via TG_TABLE_NAME; every table has row_id, list_name, item_key, version, state).
-- ---------------------------------------------------------------------------------------------------------------------
CREATE FUNCTION vera_vjay.lstreg_insert_trgfn() RETURNS trigger LANGUAGE plpgsql
  SET search_path = pg_catalog, pg_temp AS $f$
DECLARE m integer;
BEGIN
  EXECUTE pg_catalog.format('SELECT COALESCE(MAX(version), 0) FROM %I.%I WHERE list_name = $1 AND item_key = $2',
                            TG_TABLE_SCHEMA, TG_TABLE_NAME) INTO m USING NEW.list_name, NEW.item_key;
  IF NEW.version IS NULL THEN
    NEW.version := m + 1;
  ELSIF m > 0 AND NEW.version <> m + 1 THEN
    RAISE EXCEPTION '%: version for (%, %) must be % (max+1), got %', TG_TABLE_NAME, NEW.list_name, NEW.item_key, m + 1, NEW.version;
  END IF;
  NEW.created_at  := pg_catalog.now();
  NEW.modified_at := NEW.created_at;
  IF NEW.state = 'active' THEN
    EXECUTE pg_catalog.format('UPDATE %I.%I SET state = ''retired'' WHERE list_name = $1 AND item_key = $2 AND state = ''active''',
                              TG_TABLE_SCHEMA, TG_TABLE_NAME) USING NEW.list_name, NEW.item_key;
  END IF;
  RETURN NEW;
END $f$;

CREATE FUNCTION vera_vjay.lstreg_update_trgfn() RETURNS trigger LANGUAGE plpgsql
  SET search_path = pg_catalog, pg_temp AS $f$
BEGIN
  IF (pg_catalog.to_jsonb(NEW) - 'state' - 'modified_at') IS DISTINCT FROM (pg_catalog.to_jsonb(OLD) - 'state' - 'modified_at') THEN
    RAISE EXCEPTION '%: row content is immutable (insert a new version); only state may change', TG_TABLE_NAME;
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state THEN
    IF NOT ((OLD.state = 'draft'     AND NEW.state IN ('active','retired'))
         OR (OLD.state = 'active'    AND NEW.state IN ('suspended','retired'))
         OR (OLD.state = 'suspended' AND NEW.state IN ('active','retired'))) THEN
      RAISE EXCEPTION '%: state change % -> % is not allowed', TG_TABLE_NAME, OLD.state, NEW.state;
    END IF;
    IF NEW.state = 'active' THEN
      EXECUTE pg_catalog.format('UPDATE %I.%I SET state = ''retired'' WHERE list_name = $1 AND item_key = $2 AND state = ''active'' AND row_id <> $3',
                                TG_TABLE_SCHEMA, TG_TABLE_NAME) USING NEW.list_name, NEW.item_key, NEW.row_id;
    END IF;
  END IF;
  NEW.modified_at := pg_catalog.now();
  RETURN NEW;
END $f$;

CREATE FUNCTION vera_vjay.lstreg_no_delete_trgfn() RETURNS trigger LANGUAGE plpgsql
  SET search_path = pg_catalog, pg_temp AS $f$
BEGIN
  RAISE EXCEPTION '%: DELETE is not allowed (set state to retired instead)', TG_TABLE_NAME;
END $f$;

CREATE FUNCTION vera_vjay.lstreg_no_truncate_trgfn() RETURNS trigger LANGUAGE plpgsql
  SET search_path = pg_catalog, pg_temp AS $f$
BEGIN
  RAISE EXCEPTION '%: TRUNCATE is not allowed', TG_TABLE_NAME;
END $f$;

CREATE TRIGGER lstreg_lists_a_insert_trg BEFORE INSERT ON vera_vjay.lstreg_lists
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_insert_trgfn();
CREATE TRIGGER lstreg_lists_b_update_trg BEFORE UPDATE ON vera_vjay.lstreg_lists
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_update_trgfn();
CREATE TRIGGER lstreg_lists_c_no_delete_trg BEFORE DELETE ON vera_vjay.lstreg_lists
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_no_delete_trgfn();
CREATE TRIGGER lstreg_lists_d_no_truncate_trg BEFORE TRUNCATE ON vera_vjay.lstreg_lists
  FOR EACH STATEMENT EXECUTE FUNCTION vera_vjay.lstreg_no_truncate_trgfn();

CREATE TRIGGER lstreg_items_a_insert_trg BEFORE INSERT ON vera_vjay.lstreg_items
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_insert_trgfn();
CREATE TRIGGER lstreg_items_b_update_trg BEFORE UPDATE ON vera_vjay.lstreg_items
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_update_trgfn();
CREATE TRIGGER lstreg_items_c_no_delete_trg BEFORE DELETE ON vera_vjay.lstreg_items
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_no_delete_trgfn();
CREATE TRIGGER lstreg_items_d_no_truncate_trg BEFORE TRUNCATE ON vera_vjay.lstreg_items
  FOR EACH STATEMENT EXECUTE FUNCTION vera_vjay.lstreg_no_truncate_trgfn();

CREATE TRIGGER licallow_licences_a_insert_trg BEFORE INSERT ON vera_vjay.licallow_licences
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_insert_trgfn();
CREATE TRIGGER licallow_licences_b_update_trg BEFORE UPDATE ON vera_vjay.licallow_licences
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_update_trgfn();
CREATE TRIGGER licallow_licences_c_no_delete_trg BEFORE DELETE ON vera_vjay.licallow_licences
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_no_delete_trgfn();
CREATE TRIGGER licallow_licences_d_no_truncate_trg BEFORE TRUNCATE ON vera_vjay.licallow_licences
  FOR EACH STATEMENT EXECUTE FUNCTION vera_vjay.lstreg_no_truncate_trgfn();

CREATE TRIGGER entreg_entities_a_insert_trg BEFORE INSERT ON vera_vjay.entreg_entities
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_insert_trgfn();
CREATE TRIGGER entreg_entities_b_update_trg BEFORE UPDATE ON vera_vjay.entreg_entities
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_update_trgfn();
CREATE TRIGGER entreg_entities_c_no_delete_trg BEFORE DELETE ON vera_vjay.entreg_entities
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_no_delete_trgfn();
CREATE TRIGGER entreg_entities_d_no_truncate_trg BEFORE TRUNCATE ON vera_vjay.entreg_entities
  FOR EACH STATEMENT EXECUTE FUNCTION vera_vjay.lstreg_no_truncate_trgfn();

CREATE TRIGGER rptout_outlets_a_insert_trg BEFORE INSERT ON vera_vjay.rptout_outlets
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_insert_trgfn();
CREATE TRIGGER rptout_outlets_b_update_trg BEFORE UPDATE ON vera_vjay.rptout_outlets
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_update_trgfn();
CREATE TRIGGER rptout_outlets_c_no_delete_trg BEFORE DELETE ON vera_vjay.rptout_outlets
  FOR EACH ROW EXECUTE FUNCTION vera_vjay.lstreg_no_delete_trgfn();
CREATE TRIGGER rptout_outlets_d_no_truncate_trg BEFORE TRUNCATE ON vera_vjay.rptout_outlets
  FOR EACH STATEMENT EXECUTE FUNCTION vera_vjay.lstreg_no_truncate_trgfn();

-- ---------------------------------------------------------------------------------------------------------------------
-- Views: the only app-readable objects. security_barrier ON, security_invoker OFF (default): owned by the migration owner.
-- ---------------------------------------------------------------------------------------------------------------------
CREATE VIEW vera_vjay.lstreg_active_lists_v WITH (security_barrier = true) AS
  SELECT l.list_name, l.payload ->> 'shape' AS shape, l.payload ->> 'combine' AS combine, l.version
    FROM vera_vjay.lstreg_lists l
   WHERE l.state = 'active';

CREATE VIEW vera_vjay.lstreg_active_items_v WITH (security_barrier = true) AS
  SELECT u.list_name, u.item_key, u.item_rank, u.version, u.payload
    FROM (
      SELECT list_name, item_key, item_rank, version, payload FROM vera_vjay.lstreg_items       WHERE state = 'active'
      UNION ALL
      SELECT list_name, item_key, item_rank, version, payload FROM vera_vjay.licallow_licences  WHERE state = 'active'
      UNION ALL
      SELECT list_name, item_key, item_rank, version, payload FROM vera_vjay.entreg_entities    WHERE state = 'active'
      UNION ALL
      SELECT list_name, item_key, item_rank, version, payload FROM vera_vjay.rptout_outlets     WHERE state = 'active'
    ) u
   WHERE EXISTS (SELECT 1 FROM vera_vjay.lstreg_lists l WHERE l.list_name = u.list_name AND l.state = 'active');

