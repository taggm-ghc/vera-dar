# Annotated 2026-10-02 (R7a/R11a): descriptions only, never values. No Anthropic key will be used (item A2 DROPPED by R1, 2026-10-02).
# Names below were checked against the code on 2026-10-02. Variables the code also reads, listed as
# comments only (add a real line to your local .env only when you need one):
#   (no search key: M2 search is keyless arXiv; chain and limits live in config/vera_eval_run.json `search`.)
#   GROQ_API_KEY              also makes /ask free-tier-first (item #77, config/ask-provider-chain.json).
#   GROQ_API_KEY, MISTRAL_API_KEY   M6 judge providers (vera/m6/judge.py). The Groq default model is
#                             listed by Groq as shut down; the judge choice is to move into a config
#                             source (plan: internal planning notes, not published).
#   VERA_COST_LOG             file path; the M2 runner appends cost lines there if set (M2 cost is not
#                             stored in the database).
#   VERA_JUDGE_* (model, price, VERA_JUDGE_ALLOW_SAME_FAMILY=1 for a disclosed
#                             same-family judge), VERA_DEMO_SOURCE: optional overrides.
# OPENAI_API_KEY serves the generator, the baseline and (only with the same-family override) the judge.
OPENAI_API_KEY=
VERA_API_KEY=
# Operator key for /memory/pending, confirm, reject (D6). At least 32 chars, must differ from VERA_API_KEY; unset = operator routes closed (503).
VERA_OWNER_KEY=

# Render Postgres. INTERNAL_DB_URL only resolves from inside Render's private
# network (used automatically when RENDER=true, which Render sets itself —
# never set RENDER yourself). EXTERNAL_DB_URL is what local/off-Render runs
# use; it requires your current IP to be allowed in the database's Inbound
# IP Restrictions. Both use a VERA-DAR account (vera_claude_code_rw for local/dev runs), never another
# project's account: the owner's other project's accounts are refused on schema vera_vjay (verified 2026-10-07).
INTERNAL_DB_URL=
EXTERNAL_DB_URL=

# VERA-DAR database accounts (schema vera_vjay; dev and production share one instance and schema,
# so the accounts, not the host, limit the blast radius). Use the narrowest account the activity
# needs. Descriptions only: real passwords live in config/env/.env-vera (outside this directory, gitignored), never here.
# Created by db/accounts/create_vera_accounts.sql (run once as the admin; the admin login is never
# used day to day and is kept out of this file).
#   vera_claude_code_rw  DEV, read/write (group vera_vjay_rw): Claude Code, local runs, tests, eval.
#                        No DELETE on sources; sources/canonical_sources are immutable. (Other tables
#                        are mutable by grant, including UPDATE on appraisals/evidence_relations.)
#   vera_pipeline_wo     PRODUCTION, write-only (group vera_vjay_wo): the pipeline's writes.
#                        INSERT/UPDATE only, SELECT on key columns (needed for RETURNING and
#                        upserts); no content reads, no DELETE, no DDL. vera/m2_runner.py reads
#                        non-key columns, so run_m2 probably cannot run under it (not run live).
#   vera_eval_ro         PRODUCTION, read-only (group vera_vjay_ro): M6 eval, reporting, backups,
#                        inspection. SELECT only.
# Applied 2026-10-01. No further accounts. 2026-10-07: the write-only grants were verified (rolled-back
# transaction) for /ask corpus admission; ON CONFLICT is refused for it (needs SELECT on the conflict columns).
VERA_DB_PASSWORD_vera_claude_code_rw=
VERA_DB_PASSWORD_vera_pipeline_wo=
VERA_DB_PASSWORD_vera_eval_ro=

# VERA-DAR slim live MVP (vera/run_mvp.py). Names only; export real values in the process environment.
# Rw connection URL for vera_claude_code_rw (read by vera.db.get_role_engine("rw")); the runner
# asserts current_user == vera_claude_code_rw before any write and refuses any other account.
VERA_DB_URL_RW=
# Corpus admission after grounded /ask (item #79): URL for vera_pipeline_wo (write-only). Unset = disabled.
# On Render use the INTERNAL host with that account.
VERA_DB_URL_WO=
# Corpus description (item #83): URL for vera_eval_ro (read-only). Unset = the sidebar says it is not connected.
# On Render use the INTERNAL host with that account.
VERA_DB_URL_RO=
# Optional: ordered judge pool, e.g. groq:<model-id>,groq:<model-id>. Unset = the MVP runner selects
# the judge from Groq's live non-OpenAI models (quasi-dynamic; family refusal + canary before spend).
VERA_JUDGE_POOL=
